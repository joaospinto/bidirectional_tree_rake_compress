load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "btrc",
    srcs = ["src/plan.cc"],
    hdrs = [
        "include/btrc/execute.h",
        "include/btrc/plan.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "plan_test",
    srcs = [
        "tests/plan_test.cc",
        "tests/test_trees.h",
    ],
    deps = [":btrc"],
)

cc_test(
    name = "execute_test",
    srcs = [
        "tests/execute_test.cc",
        "tests/test_trees.h",
    ],
    deps = [":btrc"],
)
